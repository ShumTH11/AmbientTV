# ============================================================================
# AmbientTV — environment variables
# Copy to `.env` for local dev, or set these in your host (Vercel / Railway).
# ============================================================================

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Auth / cookies ----
# Change this in production! Used to sign JWT session cookies.
JWT_SECRET=change_this_secret_in_production
# Bearer secret for the Android TV app / proxy endpoints (/api/search).
APP_SECRET=your_app_secret_here

# ---- Database ----
# LOCAL / Railway: leave TURSO_* unset to use a local SQLite file (backend/data/users.db).
# VERCEL: set both to your Turso database URL + token. libSQL is used either way.
# TURSO_DATABASE_URL=libsql://<your-db>.turso.io
# TURSO_AUTH_TOKEN=eyJ...your-token

# ---- File uploads ----
# LOCAL / Railway: leave unset -> uploads saved to backend/media/uploads/{videos,audios,images}.
# VERCEL: set to your Vercel Blob read-write token -> uploads stored in Vercel Blob.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ---- CORS ----
# Comma-separated allowed origins. Leave empty for same-origin (frontend + API on
# the same Vercel domain). Set to your frontend domain if cross-origin.
ALLOWED_ORIGINS=

# ---- Frontend -> backend ----
# In web/.env (NOT here): VITE_API_BASE — base URL for API calls.
# Vercel same-origin: VITE_API_BASE=""   (empty -> relative /api/...)
# Self-hosted cross-origin: VITE_API_BASE="https://api.yourdomain.com"

# ---- External media search (optional) ----
PEXELS_API_KEY=
PIXABAY_API_KEY=
YOUTUBE_API_KEY=
COVERR_API_KEY=
