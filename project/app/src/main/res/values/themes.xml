<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AmbientTV Theme - Dark theme optimized for Android TV.

        Based on Theme.Leanback with a custom dark color palette that
        minimizes eye strain during ambient playback. Uses a pure black
        background for OLED displays and subtle accent colors.
    -->
    <style name="Theme.AmbientTV" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color - used for highlights and accents -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color (hidden on TV, but set for consistency) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Window configuration for TV -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
